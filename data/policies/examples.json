            "regime_type_not": "closed_autocracy"
          }
        ]
      },
      "aiHints": {
        "popularWith": [
          "bloc.usa.working_swing"
        ],
        "hatedBy": [
          "pc.usa.house_rep_hardline"
        ]
      },
      "budgetCategory": "DiscretionaryNondefense"
    },
    {
