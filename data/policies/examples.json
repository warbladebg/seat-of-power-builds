{
  "$schema": "../schemas/policies.schema.json",
  "meta": {
    "sources": [
      "src.seatofpower_authored"
    ],
    "notes": "Framework examples from package 06; the X-Date policy set is written in package 12. Debt prioritisation is an order through the Treasury chain (23: verb.prioritize_payments), not a policy (12)."
  },
  "policies": [
    {
      "id": "policy.infrastructure_package",
      "nameKey": "policy.infrastructure_package.name",
      "descriptionKey": "policy.infrastructure_package.description",
      "category": "economy.investment",
      "kind": "Law",
      "levels": [
        {
          "id": "small",
          "costBnPerYear": 60,
          "scale": 1,
          "nameKey": "policy.level.small"
        },
        {
          "id": "large",
          "costBnPerYear": 150,
          "scale": 2.5,
          "nameKey": "policy.level.large"
        }
      ],
      "position": {
        "economic": -30,
        "fiscal": -40,
        "environment": -10
      },
      "stakes": {
        "stake.district_projects": 20,
        "stake.construction_industry": 30
      },
      "implementationDays": 120,
      "effects": [
        {
          "type": "modify_var",
          "var": "econ.potential_growth@{country}",
