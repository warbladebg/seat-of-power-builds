            "delay": 90,
            "ramp": 180
          }
        }
      ],
      "budgetCategory": "DiscretionaryNondefense",
      "aiHints": {
        "popularWith": [
          "pc.usa.house_rep_hardline"
        ],
        "hatedBy": [
          "pc.usa.house_dem_progressive"
        ]
      }
    }
  ]
}
