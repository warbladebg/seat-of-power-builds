  "legalityRules": [
    {
      "id": "legality.usa.nuclear_unjustified",
      "country": "country.usa",
      "when": {
        "order": {
          "verb": "verb.launch_nuclear_strike",
          "justified": false
        }
      },
      "class": "ManifestlyUnlawful",
      "reason": "With no attack or confirmed imminent threat, a nuclear strike fails necessity and proportionality; officers have a duty to refuse manifestly unlawful orders."
    },
    {
      "id": "legality.usa.nuclear_retaliation",
      "country": "country.usa",
      "when": {
        "order": {
          "verb": "verb.launch_nuclear_strike",
          "justified": true
        }
      },
      "class": "Lawful",
      "reason": "The president has sole launch authority, and a response to an attack under way can meet necessity and proportionality."
    },
    {
      "id": "legality.usa.fire_on_protesters",
      "country": "country.usa",
      "when": {
        "order": {
          "verb": "verb.fire_on_protesters"
        }
      },
