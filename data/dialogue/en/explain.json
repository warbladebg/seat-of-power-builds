          "when": {
            "decision": "reacted"
          },
          "weight": 0.05
        },
        {
          "id": "only_option.neutral.1",
          "text": "{actor} {choice}; there was no real alternative.",
          "when": {
            "decision": "only_option"
          }
        },
        {
          "id": "one.chose.neutral.1",
          "text": "{actor} {choice}. {rival} was ruled out: {reason_1} ({weight_1}).",
