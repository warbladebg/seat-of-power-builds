    {
      "id": "dlg.summary.opening",
      "surface": "summary",
      "variables": [
        "days"
      ],
      "expects": [
        {
          "tones": [
            "Neutral"
          ]
        }
      ],
      "notes": "The recap's first line. Decision: the ending id (removed, or 12's endings); kind: default, missed_payments, paid.",
      "lines": [
        {
          "id": "any.neutral.1",
          "text": "{days} days of decisions, deals and drama are over."
        },
        {
          "id": "any.neutral.2",
          "text": "The final chapter, after {days} days."
        },
        {
          "id": "removed.neutral.1",
          "text": "After {days} days, the presidency of {leader_name} ended in removal from office.",
          "when": {
            "decision": "removed"
          }
        },
        {
          "id": "default.neutral.1",
          "text": "{days} days that will be remembered for the day {player_country} defaulted.",
          "when": {
            "kind": "default"
          }
        },
        {
          "id": "missed_payments.neutral.1",
          "text": "{days} days on the edge, and {player_country} missed payments it owed.",
          "when": {
            "kind": "missed_payments"
          }
        },
        {
          "id": "paid.neutral.1",
          "text": "{days} days, and {player_country} paid every bill it owed.",
          "when": {
            "kind": "paid"
          }
        }
      ]
    },
