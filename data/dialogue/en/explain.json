      "lines": [
        {
          "id": "any.neutral.1",
          "text": "{leader_name} ends with approval at {approval}%."
        },
        {
          "id": "any.neutral.2",
          "text": "The verdict of the public: {approval}% approval."
        },
        {
          "id": "default.neutral.1",
          "text": "Markets will remember the default for years. Approval stands at {approval}%.",
          "when": {
            "kind": "default"
          }
        },
        {
          "id": "paid.neutral.1",
          "text": "The Treasury never missed a payment. Approval stands at {approval}%.",
          "when": {
            "kind": "paid"
          }
        },
        {
          "id": "removed.neutral.1",
          "text": "{leader_name} leaves office with approval at {approval}%.",
