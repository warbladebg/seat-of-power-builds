  "decisionPoints": [
    {
      "id": "dp.execute_order",
      "actor": "character",
      "kind": "Choice",
      "deliberationDays": 1,
      "temperature": 0.7,
      "options": [
        {
          "id": "comply",
          "description": "Carry out the order."
        },
        {
          "id": "comply_slowly",
          "description": "Carry it out, but slowly and by the book.",
          "weight": 0.15
        },
        {
          "id": "ask_confirmation",
          "description": "Ask for the order in writing, or for a legal opinion, before acting.",
          "weight": 0.12
        },
        {
          "id": "refuse",
          "description": "Refuse to carry it out."
        },
        {
          "id": "resign",
          "description": "Resign rather than carry it out.",
          "weight": 0.35
        },
        {
          "id": "leak",
          "description": "Refuse, and tell the press.",
          "weight": 0.2
        },
        {
          "id": "alert_others",
          "description": "Refuse, and warn the vice president, cabinet or Congress.",
          "weight": 0.3
        }
      ],
      "considerations": [
        {
          "use": "consideration.order.legal_enough",
          "option": "comply"
        },
        {
          "use": "consideration.order.warranted",
          "option": "comply"
        },
        {
