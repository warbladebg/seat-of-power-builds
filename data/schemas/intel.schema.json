{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intel.schema.json",
  "title": "IntelSettingsDef",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "meta": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^src\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "default": null
        }
      },
      "additionalProperties": false,
      "default": null
    },
    "visibility": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "observable",
              "perceived",
              "hidden"
            ]
          },
          "via": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "pattern",
          "visibility"
        ],
        "additionalProperties": false
      },
      "default": null
    },
    "targets": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^country\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "opacity": {
            "type": "number",
            "default": 0.3,
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "country"
        ],
        "additionalProperties": false
      },
      "default": null
    },
    "params": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "number"
      },
      "default": null
    }
  },
  "additionalProperties": false
}
