{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legislature.schema.json",
  "title": "LegislatureDef",
  "type": "object",
  "properties": {
    "chambers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^chamber\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "nameKey": {
            "type": "string",
            "description": "Localisation key (data/localization/en)."
          },
          "seats": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "rules": {
            "type": "object",
            "properties": {
              "passFraction": {
                "type": "number",
                "default": 0.5,
                "minimum": 0,
                "maximum": 1
              },
              "supermajoritySeats": {
                "type": [
                  "integer",
                  "null"
                ],
                "default": null,
                "minimum": 1,
                "maximum": 10000
              },
              "vetoOverrideFraction": {
                "type": "number",
                "default": 0.6666666666666666,
                "minimum": 0,
                "maximum": 1
              },
              "viceTieBreak": {
                "type": "boolean",
                "default": false
              },
              "abstentionsCount": {
                "type": "boolean",
                "default": false
              },
              "vetoOverrideSeats": {
                "type": [
                  "integer",
                  "null"
                ],
                "default": null,
                "minimum": 1,
                "maximum": 10000
              }
            },
            "additionalProperties": false
          },
          "vacancies": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 10000
          },
          "seatsByBloc": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "propertyNames": {
              "pattern": "^pc\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
            }
          }
        },
        "required": [
          "id",
          "nameKey",
          "seats",
          "rules",
          "seatsByBloc"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "meta": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^src\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "default": null
        }
      },
      "additionalProperties": false,
      "default": null
    }
  },
  "required": [
    "chambers"
  ],
  "additionalProperties": false
}
