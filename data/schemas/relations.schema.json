{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relations.schema.json",
  "title": "RelationsDef",
  "type": "object",
  "properties": {
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^country\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "opinion": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "trust": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "target",
          "opinion",
          "trust"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "meta": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^src\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "default": null
        }
      },
      "additionalProperties": false,
      "default": null
    }
  },
  "required": [
    "relations"
  ],
  "additionalProperties": false
}
