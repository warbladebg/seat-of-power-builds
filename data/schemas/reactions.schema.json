{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reactions.schema.json",
  "title": "ReactionsFile",
  "type": "object",
  "properties": {
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^reaction\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "nameKey": {
            "type": "string",
            "description": "Localisation key (data/localization/en)."
          },
          "group": {
            "type": "string",
            "enum": [
              "voice",
              "legislative",
              "insider",
              "legal",
              "media",
              "market",
              "party",
              "diplomacy"
            ]
          },
          "actors": {
            "type": "array",
            "items": {
              "enum": [
                "Leader",
                "Official",
                "Security",
                "Career",
                "Military",
                "Legislator",
                "Bloc",
                "Judge",
                "CentralBank",
                "Media",
                "Business",
                "Civic",
                "Party",
                "Regional",
                "Challenger",
                "Foreign"
              ]
            }
          },
          "hostility": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "cost": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "maximum": 1
          },
          "publicity": {
            "type": "number",
            "default": 0.5,
            "minimum": 0,
            "maximum": 1
          },
          "escalation": {
            "type": "number",
            "default": 0.3,
            "minimum": 0,
            "maximum": 1
          },
          "minAffected": {
            "type": "number",
            "default": 0.1,
            "minimum": 0,
            "maximum": 1
          },
          "requiresPublic": {
            "type": "boolean",
            "default": false
          },
          "requiresSecret": {
            "type": "boolean",
            "default": false
          },
          "requiresOrder": {
            "type": "boolean",
            "default": false
          },
          "targetOnly": {
            "type": "boolean",
            "default": false
          },
          "requiresHarm": {
            "type": "boolean",
            "default": false
          },
          "minLegality": {
            "enum": [
              "Lawful",
              "Contested",
              "Unlawful",
              "ManifestlyUnlawful"
            ],
            "default": "Lawful"
          },
          "requiresOffice": {
            "type": "boolean",
            "default": false
          },
          "requiresInLoop": {
            "type": "boolean",
            "default": false
          },
          "party": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "enum": [
              "same",
              "opposition"
            ]
          },
          "delayDays": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 90
          },
          "delaySpread": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 60
          },
          "requires": {
            "default": null
          },
          "cascade": {
            "type": "boolean",
            "default": false
          },
          "cascadeSeverity": {
            "enum": [
              "Minor",
              "Moderate",
              "Serious",
              "Severe",
              "Catastrophic"
            ],
            "default": "Minor"
          },
          "toward": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "enum": [
              "rival",
              "partner"
            ]
          },
          "actKinds": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "default": null
          },
          "consequences": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "Approval",
                    "Scandal",
                    "Pressure",
                    "Loyalty",
                    "Capital",
                    "Publicize",
                    "Court",
                    "Obstruct",
                    "Hearing",
                    "Unrest",
                    "MarketStress",
                    "Media",
                    "Resign",
                    "Agenda",
                    "Flag",
                    "Regime",
                    "PartyRift",
                    "Relation"
                  ]
                },
                "amount": {
                  "type": "number",
                  "default": 0,
                  "minimum": -100,
                  "maximum": 100
                },
                "days": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 3650
                },
                "id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            "default": null
          },
          "effects": {
            "type": [
              "array",
              "null"
            ],
            "default": null
          },
          "optionId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "nameKey",
          "group",
          "actors",
          "hostility"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "meta": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^src\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "default": null
        }
      },
      "additionalProperties": false,
      "default": null
    }
  },
  "required": [
    "reactions"
  ],
  "additionalProperties": false
}
