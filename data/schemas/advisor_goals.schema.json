{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "advisor_goals.schema.json",
  "title": "AdvisorGoalsFile",
  "type": "object",
  "properties": {
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "variables": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "perUnit": {
                  "type": "number"
                }
              },
              "required": [
                "pattern",
                "perUnit"
              ],
              "additionalProperties": false
            },
            "default": null
          },
          "tags": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "number"
            },
            "default": null
          },
          "powerCenters": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "number"
            },
            "default": null
          }
        },
        "required": [
          "goal"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "meta": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^src\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "default": null
        }
      },
      "additionalProperties": false,
      "default": null
    }
  },
  "required": [
    "goals"
  ],
  "additionalProperties": false
}
