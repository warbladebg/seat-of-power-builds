{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "justifications.schema.json",
  "title": "JustificationsFile",
  "type": "object",
  "properties": {
    "justifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^justification\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "nameKey": {
            "type": "string",
            "description": "Localisation key (data/localization/en)."
          },
          "realIf": {
            "default": null
          },
          "strength": {
            "type": "number",
            "default": 1,
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "nameKey"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "meta": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^src\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "default": null
        }
      },
      "additionalProperties": false,
      "default": null
    }
  },
  "required": [
    "justifications"
  ],
  "additionalProperties": false
}
